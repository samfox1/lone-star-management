{
  "name": "@samfox1/site-bridge",
  "version": "0.9.0",
  "description": "The contract between the lone-star editor and a connected site: the bridge protocol, the wire payload, and the manifest schema. Framework-free — a site imports this instead of hand-mirroring it (SITE_BRIDGE_PLAN.md).",
  "type": "module",
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./payload": {
      "types": "./src/payload.ts",
      "default": "./src/payload.ts"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./markers": {
      "types": "./src/markers.ts",
      "default": "./src/markers.ts"
    },
    "./styles": {
      "types": "./src/styles.ts",
      "default": "./src/styles.ts"
    },
    "./frame": {
      "types": "./src/frame.ts",
      "default": "./src/frame.ts"
    },
    "./tokens.css": "./tokens.css",
    "./bind": {
      "types": "./src/bind.ts",
      "default": "./src/bind.ts"
    },
    "./vocabulary": {
      "types": "./src/vocabulary.ts",
      "default": "./src/vocabulary.ts"
    },
    "./social": {
      "types": "./src/social.ts",
      "default": "./src/social.ts"
    },
    "./social-icons": {
      "types": "./src/social-icons.ts",
      "default": "./src/social-icons.ts"
    },
    "./cursor": {
      "types": "./src/cursor.ts",
      "default": "./src/cursor.ts"
    },
    "./entrances": {
      "types": "./src/entrances.ts",
      "default": "./src/entrances.ts"
    },
    "./playback": {
      "types": "./src/playback.ts",
      "default": "./src/playback.ts"
    }
  },
  "files": [
    "src",
    "tokens.css"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/samfox1/lone-star-management.git",
    "directory": "packages/site-bridge"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
