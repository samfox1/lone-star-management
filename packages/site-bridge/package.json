{
  "name": "@lone-star/site-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "The contract between the lone-star editor and a connected site: the bridge protocol, the wire payload, and the manifest schema. Framework-free \u2014 a site imports this instead of hand-mirroring it (SITE_BRIDGE_PLAN.md).",
  "type": "module",
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./payload": {
      "types": "./src/payload.ts",
      "default": "./src/payload.ts"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./markers": {
      "types": "./src/markers.ts",
      "default": "./src/markers.ts"
    },
    "./styles": {
      "types": "./src/styles.ts",
      "default": "./src/styles.ts"
    },
    "./frame": {
      "types": "./src/frame.ts",
      "default": "./src/frame.ts"
    }
  },
  "files": [
    "src"
  ]
}
