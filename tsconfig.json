{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // The Edge Function ENTRYPOINT runs in Deno, not Next: it uses Deno.serve/Deno.env
  // and `./validate.ts`-style extension imports, neither of which typechecks under this
  // config. Only the entrypoint is excluded — validate.ts and _shared/cors.ts are pure
  // TS and stay covered here (and validate.ts is additionally pulled in, and therefore
  // typechecked, via tests/contact-validate.test.ts).
  "exclude": ["node_modules", "supabase/functions/contact/index.ts"]
}
