{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // Edge Functions import siblings WITH the .ts extension (Deno requires it). Legal under
    // noEmit; vitest resolves them too, so the pure modules stay typechecked and tested.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // The Edge Function ENTRYPOINT runs in Deno, not Next: it uses Deno.serve/Deno.env
  // and `./validate.ts`-style extension imports, neither of which typechecks under this
  // config. Only each door's entrypoint is excluded — the pure sibling beside it
  // (contact/validate.ts, event/derive.ts) and _shared/* stay covered here, and are also
  // pulled in, and therefore typechecked, by their unit tests under tests/unit/.
  "exclude": ["node_modules", "supabase/functions/*/index.ts"]
}
