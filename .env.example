# Copy to .env.local (app) and .env.test (tests) and fill in.
# Values come from your Supabase project: Settings → API.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify (catalog reads) — added at milestone 6
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Bandsintown — added at milestone 7
BANDSINTOWN_APP_ID=
# Compliance gate (2026-09-28): a sync refuses to run until this is the exact string
# "true" — set it by hand only once the compliance checklist in
# src/lib/manager-tools/connections/services/bandsintown/README.md ("Sync / integration"
# and "Known gaps") is actually done: attribution + Track/RSVP/Notify Me buttons on the
# public tour page, upstream-removal cleanup, written approval for commercial use.
BANDSINTOWN_TERMS_COMPLIANT=

# Shopify app ("Connect with Shopify") — the Client ID and Client secret from the app's
# settings in Shopify's Dev Dashboard (setup: src/lib/manager-tools/connections/services/
# shopify/README.md). With BOTH set, a manager types only the store address and approves on
# Shopify; with either blank, the Connect window asks for the domain + a pasted storefront
# token instead. Server-only: never NEXT_PUBLIC_. Per-store storefront tokens still live in
# Vault either way, never here.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# YouTube (video imports) — Data API v3 key from Google Cloud Console
YOUTUBE_API_KEY=

# Ticketmaster (tour dates) — Discovery API key from developer.ticketmaster.com.
# Attribution is required on the public site when live.
TICKETMASTER_API_KEY=

# Apple Music (catalog reads) — NO credentials needed. Catalog reads use the free
# iTunes Search API (no key, no paid Apple Developer Program). APPLE_STOREFRONT is the
# optional storefront country and defaults to "us".
APPLE_STOREFRONT=

# Google Drive (browse + import an artist's link-shared folder) — an API key from
# Google Cloud Console with the Drive API enabled. Public-data reads only, no OAuth.
GOOGLE_API_KEY=

# Dev-only auth bypass — set BOTH to your own account's credentials and the local
# dashboard auto-signs-in (skips /login) so you don't log in every session. It uses a
# REAL Supabase session, so RLS still applies. Ignored unless NODE_ENV=development, so it
# can never run in production. Leave blank to keep the normal login flow.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
