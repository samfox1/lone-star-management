# Copy to .env.local (app) and .env.test (tests) and fill in.
# Values come from your Supabase project: Settings → API.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify (catalog reads) — added at milestone 6
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Bandsintown — added at milestone 7
BANDSINTOWN_APP_ID=

# Shopify (per-store tokens live in the DB) — added at milestone 8
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# YouTube (video imports) — Data API v3 key from Google Cloud Console
YOUTUBE_API_KEY=

# Ticketmaster (tour dates) — Discovery API key from developer.ticketmaster.com.
# Attribution is required on the public site when live.
TICKETMASTER_API_KEY=

# Apple Music (catalog reads) — NO credentials needed. Catalog reads use the free
# iTunes Search API (no key, no paid Apple Developer Program). APPLE_STOREFRONT is the
# optional storefront country and defaults to "us".
APPLE_STOREFRONT=

# Google Drive (browse + import an artist's link-shared folder) — an API key from
# Google Cloud Console with the Drive API enabled. Public-data reads only, no OAuth.
GOOGLE_API_KEY=

# Dev-only auth bypass — set BOTH to your own account's credentials and the local
# dashboard auto-signs-in (skips /login) so you don't log in every session. It uses a
# REAL Supabase session, so RLS still applies. Ignored unless NODE_ENV=development, so it
# can never run in production. Leave blank to keep the normal login flow.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
