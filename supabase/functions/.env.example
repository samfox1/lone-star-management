# Edge Function secrets for the Edge Function doors (/contact, /event).
#
# THESE ARE NOT NEXT ENV VARS. They never belong in the repo root .env.local or
# .env.example: those files are read by the Next app, and one NEXT_PUBLIC_ typo there
# would ship the Resend key to every visitor's browser. They live in Supabase's Edge
# Function secret store instead:
#
#   supabase secrets set RESEND_API_KEY=re_...
#   supabase secrets set CONTACT_IP_SALT="$(openssl rand -hex 32)"
#   supabase secrets set CONTACT_ALLOWED_ORIGINS=https://skeen.example,https://www.skeen.example
#   supabase secrets list
#
# Copy this file to supabase/functions/.env.local (gitignored by the root `.env*` rule)
# to run `npm run fn:serve` locally.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform. Do not set
# them here and do not deploy them as secrets.

# Resend API key. Server-side only, forever.
RESEND_API_KEY=re_replace_me

# Salt for the per-IP hash stored in contact_attempts.ip_hash. MUST be long and random:
# the whole IPv4 space is ~4 billion values, so an unsalted hash is a plaintext IP
# column wearing a disguise. Generate with: openssl rand -hex 32
# Changing it resets everyone's rate-limit window, which is a fine way to clear a jam.
CONTACT_IP_SALT=replace_me_with_openssl_rand_hex_32

# Comma-separated origins allowed to POST here. NOT "*": a wildcard would let any site
# on the internet deliver its own form submissions through our verified sending domain
# into our artists' inboxes.
CONTACT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# When "true", skip the Resend call entirely and mark the enquiry sent with
# provider_message_id='dry-run'. Use this for the first deploy and for the curl
# checklist, so smoke-testing the endpoint never puts real mail in a manager's inbox.
CONTACT_DRY_RUN=true

# Where the manager reads their enquiries, e.g. https://app.lonestar.example
#   supabase secrets set LONE_STAR_APP_URL=<url>
#
# Optional. Without it the notification email says "open the enquiry in Lone Star"
# instead of linking straight to it. Deliberately NOT derived from a request header:
# a wrong link cannot be corrected once the email has been sent.

# ── /event (analytics ingest door) ─────────────────────────────────────────────────

# Salt for the per-IP hash (burst ledger, geo cache) and the daily visitor hash. MUST be
# set in production and long: unsalted, a visitor hash is a plaintext IP wearing a
# disguise. Generate with: openssl rand -hex 32. Changing it resets the burst window and
# starts a new visitor-count day (harmless once). The door refuses to start below 32 chars.
#   supabase secrets set ANALYTICS_SALT="$(openssl rand -hex 32)"
ANALYTICS_SALT=replace_me_with_openssl_rand_hex_32

# ipinfo.io token for country / region / city. OPTIONAL: without it events are still
# recorded, just with no location. Free tier covers 50k lookups a month; we cache per IP
# for two days and cap lookups at 500 an hour, so a visitor costs one lookup per two days
# at most and a flood of fresh addresses cannot spend the quota.
#   supabase secrets set IPINFO_TOKEN=...
IPINFO_TOKEN=

# Optional comma-separated origin allowlist. EMPTY means any origin, on purpose: every
# artist site — template, custom, preview deploy — posts here, and CORS is not the
# control (the per-IP cap and the per-artist caps are).
EVENT_ALLOWED_ORIGINS=
